# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# ── Datos operativos: NUNCA en git ──────────────────────────────────────────
# El repositorio es público. Estas carpetas contienen direcciones de correo de
# terceros y el estado del emisor: datos personales de personas que no han dado
# el visto bueno para que se publiquen.
/.datos
/docs/outreach/*.csv
/docs/outreach/*.txt
